# Copy to .env.local (git-ignored) and fill in. Everything here is optional --
# the board and GitHub PR badges work with no .env.local at all.

# Linear personal API key, for Linear issue/project badges.
# Linear -> Settings -> Security & access -> Personal API keys
LINEAR_API_KEY=

# Port for the local API server (default 8787).
PORT=8787

# Interface the API server binds to (default 127.0.0.1). Leave this alone unless
# you have a reason to expose the server -- it holds your credentials and has no
# auth of its own.
HOST=127.0.0.1

# Optional: Vercel token for the Deployments sidebar. By default the app reuses
# the token the Vercel CLI stored at login (`vercel login`), so this is only
# needed to override it. Create one at https://vercel.com/account/tokens
VERCEL_TOKEN=
